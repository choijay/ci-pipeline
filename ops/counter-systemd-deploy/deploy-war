#!/usr/bin/env bash
# Administrator-owned adapter called by the CD pipeline.
# Runs as gitlab-runner. Only three fixed systemctl actions use sudo.
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022
readonly APP_ROOT=/srv/counter-demo
readonly RUNNER_USER=gitlab-runner
readonly SERVICE=counter-demo.service
readonly SYSTEMCTL=/usr/bin/systemctl
readonly SUDO=/usr/bin/sudo
readonly CURL=/usr/bin/curl
readonly SS=/usr/bin/ss
readonly JAVA=/usr/lib/jvm/java-17-openjdk-amd64/bin/java
readonly CHECKS=/usr/local/lib/ci/counter-deployment-checks.jar
readonly HEALTH_TIMEOUT=180
readonly HEALTH_INTERVAL=2
readonly HEALTH_URL=http://127.0.0.1:18080/api/counter

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[[ $# == 3 ]] || fail 'Usage: deploy-war development /absolute/path/application.war version'
[[ "$(id -un)" == "$RUNNER_USER" ]] || fail 'Run via the GitLab CD job, not as root.'
[[ -f "$CHECKS" && ! -L "$CHECKS" && "$(stat -c %U "$CHECKS")" == root && ! -w "$CHECKS" ]] || fail 'Administrator-owned deployment checks are missing.'
[[ "$1" == development ]] || fail 'Only the development environment is supported.'
[[ "$2" == /* && -f "$2" ]] || fail 'An existing absolute WAR path is required.'
version="$3"
[[ "$version" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ && "$version" != *..* ]] || fail 'Invalid version.'
[[ "${version,,}" != *snapshot* && "${version,,}" != latest && "${version,,}" != release ]] || fail 'An immutable release version is required.'
expected="${DEPLOY_SHA256:-}"
expected="${expected,,}"
[[ "$expected" =~ ^[0-9a-f]{64}$ ]] || fail 'DEPLOY_SHA256 must contain 64 hexadecimal characters.'
[[ -n "${CI_PROJECT_ID:-}" ]] || fail 'CI_PROJECT_ID is required.'
source_war="$(readlink -f -- "$2")"
source_manifest="$(dirname -- "$source_war")/release.json"
[[ -f "$source_manifest" ]] || fail 'The verified release.json must be next to application.war.'
[[ -d "$APP_ROOT/releases" && -w "$APP_ROOT/releases" ]] || fail 'Run install.sh as the administrator first.'

# A second local lock also covers invocations outside the GitLab resource_group.
exec 9>"$APP_ROOT/.deploy.lock"
flock -n 9 || fail 'Another deployment is in progress.'
staging=''
previous=''
changed=0
cleanup() {
    if [[ -n "$staging" && "$staging" == "$APP_ROOT/releases/.incoming."* ]]; then
        rm -rf -- "$staging"
    fi
    rm -f -- "$APP_ROOT/.current.$$"
}
trap cleanup EXIT

set_current() {
    ln -s -- "$1" "$APP_ROOT/.current.$$" &&
    mv -Tf -- "$APP_ROOT/.current.$$" "$APP_ROOT/current"
}

restart_service() {
    # No reset is needed for a fresh/inactive unit. Failed units retain their
    # state; clear it before retrying, and do not hide errors from that operation.
    if "$SYSTEMCTL" is-failed --quiet "$SERVICE"; then
        "$SUDO" -n "$SYSTEMCTL" reset-failed "$SERVICE" || return $?
    fi
    "$SUDO" -n "$SYSTEMCTL" restart "$SERVICE"
}

healthy() {
    local deadline=$((SECONDS + HEALTH_TIMEOUT)) body good=0
    while (( SECONDS < deadline )); do
        if "$SYSTEMCTL" is-active --quiet "$SERVICE" &&
           body="$("$CURL" --noproxy '*' --fail --silent --show-error \
               --connect-timeout 2 --max-time 3 "$HEALTH_URL" 2>/dev/null)" &&
           "$JAVA" -jar "$CHECKS" health \
               <<<"$body" >/dev/null 2>&1; then
            good=$((good + 1))
            (( good >= 2 )) && return 0
        else
            good=0
        fi
        sleep "$HEALTH_INTERVAL"
    done
    return 1
}

on_failure() {
    local code="${1:-1}"
    trap - ERR INT TERM HUP
    set +e
    printf 'ERROR: Deployment failed; see journalctl -u %s.\n' "$SERVICE" >&2
    if (( changed )); then
        "$SUDO" -n "$SYSTEMCTL" stop "$SERVICE"
        rm -f -- "$APP_ROOT/.current.$$"
        if [[ -n "$previous" ]]; then
            if set_current "$previous" && restart_service && healthy; then
                echo "Rollback succeeded: $(basename -- "$previous")" >&2
            else
                echo 'ERROR: Rollback could not be verified. Administrator intervention is required.' >&2
            fi
        else
            rm -f -- "$APP_ROOT/current"
            echo 'First deployment failed. No previous release exists; the service has been stopped.' >&2
        fi
        printf '%s FAILED %s\n' "$(date -u +%FT%TZ)" "$version" >> "$APP_ROOT/deployments.log"
    fi
    exit "$code"
}
trap 'on_failure $?' ERR
trap 'on_failure 130' INT
trap 'on_failure 143' TERM
trap 'on_failure 129' HUP

# Copy first; all checks apply to the bytes that will actually be installed.
staging="$(mktemp -d "$APP_ROOT/releases/.incoming.XXXXXX")"
chmod 0755 "$staging"
install -m 0644 -- "$source_war" "$staging/application.war"
install -m 0644 -- "$source_manifest" "$staging/release.json"
"$JAVA" -jar "$CHECKS" war "$staging" "$version" "$expected" "$CI_PROJECT_ID"

candidate="$APP_ROOT/releases/$version"
if [[ -e "$candidate" || -L "$candidate" ]]; then
    [[ -d "$candidate" && ! -L "$candidate" && -f "$candidate/application.war" ]] || fail 'Existing release directory is invalid.'
    [[ "$(sha256sum -- "$candidate/application.war" | cut -d' ' -f1)" == "$expected" ]] || fail 'This version already exists with different WAR contents.'
    cmp -s -- "$staging/release.json" "$candidate/release.json" || fail 'This version already exists with different metadata.'
    rm -rf -- "$staging"
    staging=''
else
    mv -- "$staging" "$candidate"
    staging=''
fi

if [[ -e "$APP_ROOT/current" || -L "$APP_ROOT/current" ]]; then
    [[ -L "$APP_ROOT/current" ]] || fail 'current must be a managed symbolic link.'
    previous="$(readlink -f -- "$APP_ROOT/current")"
    [[ "$(dirname -- "$previous")" == "$APP_ROOT/releases" && -f "$previous/application.war" ]] || fail 'Previous release is invalid.'
fi

# Stop only this sample service. Never kill another process occupying the port.
changed=1
"$SUDO" -n "$SYSTEMCTL" stop "$SERVICE"
listeners="$("$SS" -H -ltn 'sport = :18080')"
if [[ -n "$listeners" ]]; then
    echo 'ERROR: Port 18080 is used by another process. It will not be terminated.' >&2
    on_failure 1
fi
set_current "$candidate"
restart_service
if ! healthy; then
    echo "ERROR: Application health check failed within ${HEALTH_TIMEOUT}s." >&2
    on_failure 1
fi
printf '%s SUCCESS %s %s\n' "$(date -u +%FT%TZ)" "$version" "$expected" >> "$APP_ROOT/deployments.log"
changed=0
printf 'Deployment succeeded: %s\n' "$version"
